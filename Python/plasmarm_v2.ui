  <property name="styleSheet">
   <string notr="true">*{
	border: none;
	background-color: transparent;
	background: none;
	padding: 0;
	margin: 0;
	color: #fff;
}




#centralwidget{
	background-color: #16191d;
}

#leftsubcontainer{
	background-color: #16191d;
}

#leftsubcontainer QPushButton{
	
	background-color: #16191d;
	text-align: left;
	padding: 2px 10px;
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
}

#leftsubcontainer QPushButton:hover {
        background-color: rgb(59, 65, 80);
}
#rightContainer{
	background-color: #16191d;
}

#headerContainer{
	background-color: #2c313c;
}

QToolTip {
    background-color: #16191d;
    color: white;
    border: 1px solid #2a2d31;
    padding: 4px;
    border-radius: 4px;
}



#ConnectionPanel{
	background-color:rgb(32, 36, 44);
}
#ConnectionPanel QPushButton{
	
	background-color: #16191d;
	text-align: left;
	padding: 2px 10px;
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
}
#ConnectionPanel QLineEdit {
    background-color: #262b34;
    border: 1px solid #2f3540;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e6f1ff;
}

#ConnectionPanel QLineEdit:hover {
    border: 1px solid #3a4150;
}

#ConnectionPanel QLineEdit:focus {
    border: 1px solid #1e7cc7;
    background-color: #2b303a;
}

#ConnectionPanel QPushButton {
    background-color: #262b34;
    border: 1px solid #2f3540;
    border-radius: 6px;
    padding: 6px 12px;
    color: #e6f1ff;
}

#ConnectionPanel QPushButton:hover {
    background-color: #2b303a;
    border-color: #3a4150;
}



#Connection_Title{
	background-color: #2c313c;
}

#MainContainer{
background-color: rgb(1, 26, 48);
}

#graphicsView{
	border: none;
    border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	background: rgb(255, 255, 255);
}

#ControlContainer QPushButton{
	background-color:rgb(3, 60, 107);
	text-align: center;
	padding: 2px 10px;
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-right-radius: 10px;
}
#ControlContainer QPushButton:hover {
        background-color: rgb(4, 78, 135);
}


QPushButton:hover {
        background-color: rgb(59, 65, 80);
}

#rightMenuContainer QPushButton{
	padding: 2px 10px;
	border-top-left-radius: 5px;
	border-bottom-left-radius: 5px;
	border-top-right-radius: 5px;
	border-bottom-right-radius: 5px;
}

QLineEdit {
    background-color: #06263f;
    border: 1px solid #0d3a5c;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e6f1ff;
}

QLineEdit:hover {
    border: 1px solid #14507c;
}

QLineEdit:focus {
    border: 1px solid #1e7cc7;
    background-color: #0a2f4a;
}

QLineEdit::placeholder {
    color: #7a8fa7;
}

</string>
