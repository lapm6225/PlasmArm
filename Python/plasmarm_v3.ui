  <property name="styleSheet">
   <string notr="true">
* {
    font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
    color: #ecf0f1;
}

#centralwidget {
    background-color: #0c0f12;
}

#headerContainer {
    background-color: #121519;
    border-bottom: 2px solid #1E232B;
}

#headerTitle {
    color: #3498db;
    font-size: 16px;
    font-weight: bold;
    padding-left: 10px;
}

#leftSidebar, #ControlContainer, #ConnectionPanel {
    background-color: #1A1F27;
    border: 1px solid #2C3542;
    border-radius: 8px;
    margin: 5px;
}

QPushButton {
    background-color: #28303C;
    border: 1px solid #3C475A;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3C475A;
    border-color: #3498db;
}

QPushButton:pressed {
    background-color: #1A1F27;
}

QPushButton:checked {
    background-color: #2980b9;
    border-color: #3498db;
}

/* BIG BUTTONS */
#startBtn {
    background-color: #27ae60;
    color: white;
    font-size: 16px;
    font-weight: bold;
    border: 2px solid #2ecc71;
    border-radius: 8px;
    padding: 20px;
}
#startBtn:hover {
    background-color: #2ecc71;
    border-color: #FFF;
}

#stopBtn {
    background-color: #c0392b;
    color: white;
    font-size: 18px;
    font-weight: bold;
    border: 2px solid #e74c3c;
    border-radius: 8px;
    padding: 25px;
}
#stopBtn:hover {
    background-color: #e74c3c;
    border-color: #FFF;
    box-shadow: 0 0 10px #e74c3c;
}

/* INPUTS */
QLineEdit {
    background-color: #07090b;
    border: 1px solid #3C475A;
    border-radius: 6px;
    padding: 8px;
    color: #3498db;
    font-weight: bold;
    selection-background-color: #3498db;
}
QLineEdit:focus {
    border: 1px solid #3498db;
    background-color: #0c0f12;
}

/* GRAPHICS VIEW */
#graphicsView {
    background-color: #ECF0F1;
    border: 2px solid #2C3542;
    border-radius: 10px;
    margin: 5px;
}

/* LABELS */
QLabel {
    color: #7f8c8d;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
}

#lblMachineStatus {
    color: #BDC3C7;
    font-size: 14px;
}

/* WINDOW CONTROLS */
#closeBtn { background-color: transparent; border: none; }
#closeBtn:hover { background-color: #e74c3c; }
#minBtn, #maxBtn { background-color: transparent; border: none; }
#minBtn:hover, #maxBtn:hover { background-color: #3C475A; }
   </string>
  </property>

